# Use official slim Python 3.12 base image
FROM python:3.12-slim

# Set working directory inside container
WORKDIR /app

# Copy only requirements.txt first to leverage Docker cache if dependencies unchanged
COPY requirements.txt /app/

# Upgrade pip and install dependencies from requirements.txt without cache
RUN python3 -m pip install --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# Copy the rest of the project files into the container
COPY . /app

# Expose port FastAPI uses
EXPOSE 8000

# Run FastAPI app using python and uvicorn
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
